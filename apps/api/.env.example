# Local development only. Production values come from Azure Key Vault via managed identity.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ehr?schema=public"
JWT_SECRET="change-me-in-dev-only"
JWT_EXPIRES_IN="15m"
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# Azure Blob Storage. Leave AZURE_STORAGE_ACCOUNT empty to use local ./blob-dev folder.
AZURE_STORAGE_ACCOUNT=""
BLOB_LOCAL_DIR="./blob-dev"
