generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Tenancy & identity ----------

model Practice {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  fax       String?
  email     String?
  website   String?
  address   String?
  npi       String?
  taxId     String?
  timezone  String?
  hours     Json?
  logoUrl   String?
  createdAt DateTime @default(now())

  users            User[]
  patients         Patient[]
  appointments     Appointment[]
  encounters       Encounter[]
  prescriptions    Prescription[]
  examTemplates    ExamTemplate[]
  reportTemplates  ReportTemplate[]
  orders           OpticalOrder[]
  inventoryItems   InventoryItem[]
  recalls          Recall[]
  tasks            Task[]
  auditEvents      AuditEvent[]
  appointmentTypes AppointmentType[]
  acceptedPayers   AcceptedPayer[]
  lensPriceLists   LensPriceList[]
  opticalAddOns    OpticalAddOn[]
  contactLensProducts ContactLensProduct[]
  contactLensFees  ContactLensFee[]
  codeEntries      CodeCatalogEntry[]
}

enum Role {
  DOCTOR
  TECHNICIAN
  OPTICIAN
  RECEPTIONIST
  ADMIN
}

model User {
  id            String   @id @default(uuid())
  practiceId    String
  practice      Practice @relation(fields: [practiceId], references: [id])
  entraObjectId String?  @unique // Microsoft Entra ID subject; null until linked
  email         String   @unique
  passwordHash  String? // dev/local fallback only; production uses Entra ID
  firstName     String
  lastName      String
  role          Role
  licenseNumber String? // doctors
  npi           String? // doctors
  isActive      Boolean  @default(true)
  // UI/accessibility preferences (theme, font scale, exam layout, etc.). Not PHI.
  preferences   Json?
  // Per-user departures from the role's default capabilities.
  // Shape: { grant: string[], deny: string[] } of permission keys; see auth/permissions.ts.
  // Effective set = roleDefaults(role) + grant - deny. ADMIN always holds every key.
  permissionOverrides Json?
  createdAt     DateTime @default(now())

  signedEncounters Encounter[]    @relation("SignedBy")
  voidedEncounters Encounter[]    @relation("VoidedBy")
  prescriptions    Prescription[]
  addenda          Addendum[]
  auditEvents      AuditEvent[]
  appointments     Appointment[]  @relation("Provider")
  tasksAssigned    Task[]         @relation("Assignee")
  documentLinks    EncounterDocument[]
  historyReviews   PatientHistoryReview[]
}

// ---------- Patient chart ----------

enum Sex {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum PatientTag {
  ORTHO_K
  MYOPIA_MANAGEMENT
  SPECIALTY_CL
  DRY_EYE
  VISION_THERAPY
  LOW_VISION
}

model Patient {
  id         String    @id @default(uuid())
  practiceId String
  practice   Practice  @relation(fields: [practiceId], references: [id])
  mrn        String // human-friendly chart number, unique per practice
  firstName  String
  lastName   String
  dateOfBirth DateTime?
  sex        Sex       @default(UNKNOWN)
  email      String?
  phone      String?
  address    String?
  city       String?
  state      String?
  zip        String?
  preferredContact String? // phone | email | sms
  alerts     String? // allergies to drops, mobility needs, etc.
  notes      String?
  tags       PatientTag[] @default([])
  consentSignedAt  DateTime?
  isActive   Boolean   @default(true)
  mergedIntoId String? // set when this chart was merged into another
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  histories     PatientHistory[]
  intakeHistory PatientIntakeHistory?
  insurances    InsurancePolicy[]
  appointments  Appointment[]
  encounters    Encounter[]
  prescriptions Prescription[]
  documents     Document[]
  orders        OpticalOrder[]
  recalls       Recall[]

  @@unique([practiceId, mrn])
  @@index([practiceId, lastName, firstName])
  @@index([practiceId, dateOfBirth])
}

enum HistoryKind {
  MEDICAL
  OCULAR
  FAMILY
  MEDICATION
  ALLERGY
  DIAGNOSIS
}

model PatientHistory {
  id        String      @id @default(uuid())
  patientId String
  patient   Patient     @relation(fields: [patientId], references: [id])
  kind      HistoryKind
  code      String? // ICD-10 for diagnoses, RxNorm for meds when known
  label     String
  detail    String?
  onsetDate DateTime?
  resolved  Boolean     @default(false)
  createdAt DateTime    @default(now())

  @@index([patientId, kind])
}

/// The paper intake questionnaire: Social, Family, Review of Systems, and Past
/// Medical History, plus surgical history, allergies, and medications. Captured
/// once per patient and re-confirmed at each visit rather than re-asked.
///
/// `answers` is a JSON map of questionKey -> { status, detail } where status is
/// "ce" (can't elaborate), "no", or "yes", and detail carries the paper form's
/// follow-up column (how often / relationship to you / how long). Keeping it as
/// JSON lets the question set change without a migration; the shape is
/// validated in the service layer.
model PatientIntakeHistory {
  id              String    @id @default(uuid())
  patientId       String    @unique
  patient         Patient   @relation(fields: [patientId], references: [id])
  answers         Json      @default("{}")
  patientSignedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  reviews PatientHistoryReview[]
}

/// One "Re-Reviewed Date / Dr.'s Signature" line from the paper form: a provider
/// attesting that the intake history was reviewed at a visit, with or without
/// changes. Rows are append-only so the review trail survives later edits.
model PatientHistoryReview {
  id           String               @id @default(uuid())
  intakeId     String
  intake       PatientIntakeHistory @relation(fields: [intakeId], references: [id])
  encounterId  String?
  reviewedById String
  reviewedBy   User                 @relation(fields: [reviewedById], references: [id])
  changesNoted Boolean              @default(false)
  note         String?
  reviewedAt   DateTime             @default(now())

  @@index([intakeId, reviewedAt])
}

// ---------- Insurance (records only; no claims in v1) ----------

enum SubscriberRelation {
  SELF
  SPOUSE
  CHILD
  OTHER
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
  INACTIVE
}

model InsurancePolicy {
  id             String             @id @default(uuid())
  patientId      String
  patient        Patient            @relation(fields: [patientId], references: [id])
  acceptedPayerId String?
  acceptedPayer   AcceptedPayer?    @relation(fields: [acceptedPayerId], references: [id])
  payerName      String
  planName       String?
  memberId       String
  groupNumber    String?
  subscriberName String?
  relation       SubscriberRelation @default(SELF)
  effectiveDate  DateTime?
  expirationDate DateTime?
  isVision       Boolean            @default(true) // vision vs medical plan
  priority       Int                @default(1) // 1 = primary
  cardFrontDocId String?
  cardBackDocId  String?
  verification   VerificationStatus @default(UNVERIFIED)
  verifiedAt     DateTime?
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([patientId])
}

// Practice catalog of insurance payers accepted at the front desk.
model AcceptedPayer {
  id                String   @id @default(uuid())
  practiceId        String
  practice          Practice @relation(fields: [practiceId], references: [id])
  name              String // e.g. EyeMed, Spectera, Fidelis Care
  notes             String?
  eligibilityNotes  String?
  phone             String?
  fax               String?
  website           String?
  payerId           String?
  frameAllowance    Decimal? @db.Decimal(10, 2)
  lensAllowance     Decimal? @db.Decimal(10, 2)
  examCopay         Decimal? @db.Decimal(10, 2)
  requiresAuth      Boolean  @default(false)
  isVision          Boolean  @default(true)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  policies          InsurancePolicy[]

  @@unique([practiceId, name])
  @@index([practiceId, isActive])
}

// ---------- Scheduling ----------

model AppointmentType {
  id           String   @id @default(uuid())
  practiceId   String
  practice     Practice @relation(fields: [practiceId], references: [id])
  name         String // Comprehensive Exam, CL Fitting, Follow-up...
  durationMin  Int      @default(30)
  color        String? // calendar display
  isActive     Boolean  @default(true)

  appointments Appointment[]
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  WAITING
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id         String            @id @default(uuid())
  practiceId String
  practice   Practice          @relation(fields: [practiceId], references: [id])
  patientId  String
  patient    Patient           @relation(fields: [patientId], references: [id])
  providerId String
  provider   User              @relation("Provider", fields: [providerId], references: [id])
  typeId     String
  type       AppointmentType   @relation(fields: [typeId], references: [id])
  startsAt   DateTime
  endsAt     DateTime
  status     AppointmentStatus @default(SCHEDULED)
  notes      String?
  cancelReason String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  encounter Encounter?

  @@index([practiceId, providerId, startsAt])
  @@index([patientId, startsAt])
}

// ---------- Exams (encounters) ----------

model ExamTemplate {
  id         String   @id @default(uuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id])
  name       String
  version    Int      @default(1)
  // Ordered section definitions: visibility, required flags, custom fields.
  // Shape: [{ key, title, enabled, requiredFields: [], customFields: [{key,label,type}] }]
  sections   Json
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  encounters Encounter[]

  @@unique([practiceId, name, version])
}

enum EncounterStatus {
  IN_PROGRESS
  SIGNED
  VOIDED
}

model Encounter {
  id            String          @id @default(uuid())
  practiceId    String
  practice      Practice        @relation(fields: [practiceId], references: [id])
  patientId     String
  patient       Patient         @relation(fields: [patientId], references: [id])
  appointmentId String?         @unique
  appointment   Appointment?    @relation(fields: [appointmentId], references: [id])
  templateId    String
  template      ExamTemplate    @relation(fields: [templateId], references: [id])
  status        EncounterStatus @default(IN_PROGRESS)

  chiefComplaint String?
  // Structured clinical data keyed by template section (validated in service layer).
  // Includes: visualAcuity, refraction, keratometry, pupilsEomFields, iop, slitLamp,
  // posteriorSegment, plus template custom sections.
  clinicalData   Json     @default("{}")
  assessment     String?
  plan           String?
  diagnosisCodes String[] // ICD-10
  procedureCodes String[] // CPT (superbill support)

  signedById String?
  signedBy   User?     @relation("SignedBy", fields: [signedById], references: [id])
  signedAt   DateTime?

  // Voiding retracts a draft exam without destroying it; signed exams are
  // corrected with addenda instead.
  voidedById String?
  voidedBy   User?     @relation("VoidedBy", fields: [voidedById], references: [id])
  voidedAt   DateTime?
  voidReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addenda       Addendum[]
  prescriptions Prescription[]
  reports       GeneratedReport[]
  documentLinks EncounterDocument[]

  @@index([practiceId, patientId, createdAt])
}

model Addendum {
  id          String    @id @default(uuid())
  encounterId String
  encounter   Encounter @relation(fields: [encounterId], references: [id])
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  text        String
  createdAt   DateTime  @default(now())
}

// ---------- Prescriptions (immutable, versioned) ----------

enum PrescriptionType {
  SPECTACLE
  CONTACT_LENS
}

enum PrescriptionStatus {
  DRAFT
  FINALIZED
  SUPERSEDED
  EXPIRED
}

model Prescription {
  id          String             @id @default(uuid())
  practiceId  String
  practice    Practice           @relation(fields: [practiceId], references: [id])
  patientId   String
  patient     Patient            @relation(fields: [patientId], references: [id])
  encounterId String?
  encounter   Encounter?         @relation(fields: [encounterId], references: [id])
  prescriberId String
  prescriber  User               @relation(fields: [prescriberId], references: [id])
  type        PrescriptionType
  status      PrescriptionStatus @default(DRAFT)
  version     Int                @default(1)
  supersedesId String?           @unique
  supersedes   Prescription?     @relation("Supersession", fields: [supersedesId], references: [id])
  supersededBy Prescription?     @relation("Supersession")

  // Spectacle: { od: {sphere,cylinder,axis,add,prism,base}, os: {...}, pd, pdNear, remarks }
  // Contact lens: { od: {brand,material,baseCurve,diameter,sphere,cylinder,axis,add}, os: {...},
  //                 wearSchedule, replacementSchedule, remarks }
  values Json

  issuedAt    DateTime?
  expiresAt   DateTime?
  finalizedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  orders  OpticalOrder[]
  reports GeneratedReport[]

  @@index([patientId, type, status])
}

// ---------- Documents & reports ----------

/// What a scanned/imported file actually is. Drives which structured fields the
/// UI offers and which documents can be pulled forward into an exam.
enum DocumentKind {
  EXTERNAL_RECORD // outside chart notes, referral packets
  EXTERNAL_RX // spectacle/CL prescription written by another doctor
  KERATOMETRY // K readings from an outside device or provider
  REFERRAL_LETTER
  LAB_IMAGING
  INSURANCE_CARD
  OTHER
}

/// Values transcribed or OCR'd off a document are never trusted clinically
/// until a technician or doctor confirms them against the source image.
enum DocumentReviewStatus {
  PENDING_REVIEW
  REVIEWED
  REJECTED
}

model Document {
  id          String   @id @default(uuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id])
  fileName    String
  contentType String
  blobPath    String // container-relative path in Azure Blob Storage
  sha256      String
  sizeBytes   Int
  category    String? // free-text label kept for pre-DocumentKind rows
  kind        DocumentKind @default(OTHER)
  externalProvider String? // clinic/doctor the record came from
  documentDate DateTime? // date printed on the paper, not the upload date
  // Structured values read off the document, shape per kind:
  // EXTERNAL_RX  { od: {sphere,cylinder,axis,add}, os: {...}, pd, notes }
  // KERATOMETRY  { od: {k1,k2,kAxis}, os: {...}, notes }
  // Validated in DocumentsService; only meaningful once reviewStatus = REVIEWED.
  extractedData Json?
  reviewStatus DocumentReviewStatus @default(PENDING_REVIEW)
  reviewedById String?
  reviewedAt   DateTime?
  uploadedById String?
  createdAt   DateTime @default(now())

  encounterLinks EncounterDocument[]

  @@index([patientId])
  @@index([patientId, kind])
}

/// Join between a chart document and the visits it is relevant to. A single
/// scanned outside Rx is uploaded once and referenced by every exam that needs
/// it, mirroring how one photocopy sits in a paper folder across visits.
model EncounterDocument {
  id          String    @id @default(uuid())
  encounterId String
  encounter   Encounter @relation(fields: [encounterId], references: [id])
  documentId  String
  document    Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  linkedById  String?
  linkedBy    User?     @relation(fields: [linkedById], references: [id])
  linkedAt    DateTime  @default(now())

  @@unique([encounterId, documentId])
  @@index([documentId])
}

model ReportTemplate {
  id         String   @id @default(uuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id])
  name       String
  kind       String // spectacle-rx | contact-lens-rx | exam-summary
  version    Int      @default(1)
  // Layout config: header/branding, visible fields, footer text, signature block.
  layout     Json
  isActive   Boolean  @default(true)
  // Exactly one active default per kind is enforced in ReportsService.
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  reports GeneratedReport[]

  @@unique([practiceId, name, version])
}

model GeneratedReport {
  id             String         @id @default(uuid())
  templateId     String
  template       ReportTemplate @relation(fields: [templateId], references: [id])
  encounterId    String?
  encounter      Encounter?     @relation(fields: [encounterId], references: [id])
  prescriptionId String?
  prescription   Prescription?  @relation(fields: [prescriptionId], references: [id])
  blobPath       String
  sha256         String
  generatedById  String
  createdAt      DateTime       @default(now())
}

// ---------- Optical operations ----------

enum OrderKind {
  SPECTACLE
  CONTACT_LENS
}

enum OrderStatus {
  DRAFT
  ORDERED
  AT_LAB
  RECEIVED
  VERIFIED
  DISPENSED
  REMAKE
  CANCELLED
}

model OpticalOrder {
  id             String       @id @default(uuid())
  practiceId     String
  practice       Practice     @relation(fields: [practiceId], references: [id])
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id])
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  kind           OrderKind
  status         OrderStatus  @default(DRAFT)

  // Spectacle: { frame: {brand,model,color,eye,bridge,temple,source}, lens: {design,material,
  //   coatings[]}, measurements: {pdOd,pdOs,segHeightOd,segHeightOs,oc,vertex,pantoTilt,wrap} }
  // Contact lens: { odQty, osQty, brand, supplyMonths, trial: boolean }
  details Json

  labName      String?
  labReference String?
  priceTotal   Decimal? @db.Decimal(10, 2)
  deposit      Decimal? @db.Decimal(10, 2)
  balanceDue   Decimal? @db.Decimal(10, 2)
  warrantyNotes String?
  remakeOfId   String?  @unique
  remakeOf     OpticalOrder? @relation("Remake", fields: [remakeOfId], references: [id])
  remadeBy     OpticalOrder? @relation("Remake")

  orderedAt   DateTime?
  receivedAt  DateTime?
  dispensedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  statusEvents OrderStatusEvent[]

  @@index([practiceId, status])
  @@index([patientId])
}

model OrderStatusEvent {
  id        String       @id @default(uuid())
  orderId   String
  order     OpticalOrder @relation(fields: [orderId], references: [id])
  status    OrderStatus
  note      String?
  actorId   String?
  createdAt DateTime     @default(now())

  @@index([orderId, createdAt])
}

// ---------- Inventory ----------

enum InventoryKind {
  FRAME
  CONTACT_LENS_TRIAL
  OTHER
}

model InventoryItem {
  id           String        @id @default(uuid())
  practiceId   String
  practice     Practice      @relation(fields: [practiceId], references: [id])
  kind         InventoryKind
  sku          String
  brand        String?
  model        String?
  color        String?
  size         String?
  eye          String?
  bridge       String?
  temple       String?
  a            String?
  b            String?
  ed           String?
  material     String?
  shape        String?
  upc          String?
  reorderPoint Int?
  quantity     Int           @default(0)
  cost         Decimal?      @db.Decimal(10, 2)
  retail       Decimal?      @db.Decimal(10, 2)
  isActive     Boolean       @default(true)
  updatedAt    DateTime      @updatedAt

  @@unique([practiceId, sku])
}

enum LensDesign {
  SV
  BIFOCAL
  PAL
  OFFICE
  OTHER
}

enum OpticalAddOnKind {
  AR
  UV
  PHOTOCHROMIC
  POLARIZED
  BLUE_LIGHT
  EDGE
  OTHER
}

model LensPriceList {
  id         String      @id @default(uuid())
  practiceId String
  practice   Practice    @relation(fields: [practiceId], references: [id])
  name       String
  design     LensDesign  @default(SV)
  material   String
  index      Decimal?    @db.Decimal(4, 2)
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  ranges     LensPriceRange[]

  @@unique([practiceId, name])
}

/// One priced power band on a lens price list, e.g. sphere -4.00..+4.00 with
/// cylinder -2.00..0.00 at $89. Bands are minus-cyl, so cylMin <= cylMax <= 0.
/// A quote picks the narrowest band containing the Rx; overlapping bands are
/// resolved by sortOrder, letting a practice layer surcharge bands over a base
/// band without rewriting the whole sheet. Imported full SPH x CYL grids are
/// collapsed into the smallest set of bands that reproduces them exactly.
model LensPriceRange {
  id          String        @id @default(uuid())
  priceListId String
  priceList   LensPriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  label       String?
  sphMin      Decimal       @db.Decimal(5, 2)
  sphMax      Decimal       @db.Decimal(5, 2)
  cylMin      Decimal       @db.Decimal(5, 2)
  cylMax      Decimal       @db.Decimal(5, 2)
  price       Decimal       @db.Decimal(10, 2)
  sortOrder   Int           @default(0)

  @@index([priceListId, sortOrder])
}

model OpticalAddOn {
  id         String           @id @default(uuid())
  practiceId String
  practice   Practice         @relation(fields: [practiceId], references: [id])
  name       String
  kind       OpticalAddOnKind @default(OTHER)
  price      Decimal          @db.Decimal(10, 2)
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([practiceId, name])
}

// ---------- Contact lens pricing ----------

enum ContactLensModality {
  DAILY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
  OTHER
}

enum ContactLensType {
  SPHERICAL
  TORIC
  MULTIFOCAL
  MULTIFOCAL_TORIC
  RGP
  SCLERAL
  ORTHO_K
  OTHER
}

/// A stocked contact lens the practice quotes and sells. Priced per box rather
/// than per power: unlike spectacle lenses, parameters do not change the price,
/// but annual-supply and six-month bundles are quoted at a discount off the
/// per-box rate, so both are stored instead of derived.
model ContactLensProduct {
  id                 String              @id @default(uuid())
  practiceId         String
  practice           Practice            @relation(fields: [practiceId], references: [id])
  brand              String
  productName        String
  modality           ContactLensModality @default(MONTHLY)
  lensType           ContactLensType     @default(SPHERICAL)
  lensesPerBox       Int?
  /// Boxes one eye consumes in a year; an annual supply for both eyes bills twice this.
  boxesPerYearPerEye Int                 @default(4)
  pricePerBox        Decimal             @db.Decimal(10, 2)
  /// Bundle prices per eye. Null means quote at the per-box rate instead.
  annualSupplyPrice  Decimal?            @db.Decimal(10, 2)
  sixMonthPrice      Decimal?            @db.Decimal(10, 2)
  rebateNote         String?
  notes              String?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([practiceId, brand, productName])
  @@index([practiceId, isActive])
}

enum ContactLensFeeKind {
  FITTING_STANDARD
  FITTING_TORIC
  FITTING_MULTIFOCAL
  FITTING_SPECIALTY
  FITTING_ORTHO_K
  EVALUATION
  FOLLOW_UP
  OTHER
}

/// Professional fees quoted alongside contact lens material, kept separate from
/// product pricing because insurance allowances apply to them differently.
model ContactLensFee {
  id         String             @id @default(uuid())
  practiceId String
  practice   Practice           @relation(fields: [practiceId], references: [id])
  name       String
  kind       ContactLensFeeKind @default(OTHER)
  price      Decimal            @db.Decimal(10, 2)
  isActive   Boolean            @default(true)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([practiceId, name])
}

// ---------- Billing & diagnosis code catalog ----------

enum CodeSystem {
  ICD10
  CPT
  HCPCS
}

/// Practice-maintained diagnosis and procedure codes offered in exam pickers.
/// Seeded from the bundled optometry starter sets, then editable: a practice can
/// add codes, retire ones it never bills, and flag the handful it uses daily so
/// they sort to the top of the lookup.
model CodeCatalogEntry {
  id          String     @id @default(uuid())
  practiceId  String
  practice    Practice   @relation(fields: [practiceId], references: [id])
  system      CodeSystem
  code        String
  description String
  category    String?
  isFavorite  Boolean    @default(false)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([practiceId, system, code])
  @@index([practiceId, system, isActive])
}

// ---------- Recalls & tasks ----------

enum RecallStatus {
  PENDING
  CONTACTED
  SCHEDULED
  DISMISSED
}

model Recall {
  id         String       @id @default(uuid())
  practiceId String
  practice   Practice     @relation(fields: [practiceId], references: [id])
  patientId  String
  patient    Patient      @relation(fields: [patientId], references: [id])
  reason     String // annual exam, CL follow-up...
  dueDate    DateTime
  status     RecallStatus @default(PENDING)
  notes      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([practiceId, status, dueDate])
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
}

model Task {
  id         String     @id @default(uuid())
  practiceId String
  practice   Practice   @relation(fields: [practiceId], references: [id])
  assigneeId String?
  assignee   User?      @relation("Assignee", fields: [assigneeId], references: [id])
  title      String
  detail     String?
  patientId  String?
  dueDate    DateTime?
  status     TaskStatus @default(OPEN)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([practiceId, status])
}

// ---------- Audit (append-only) ----------

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  EXPORT
  PRINT
  LOGIN
  LOGOUT
  SIGN
  FINALIZE
}

model AuditEvent {
  id         String      @id @default(uuid())
  practiceId String
  practice   Practice    @relation(fields: [practiceId], references: [id])
  actorId    String?
  actor      User?       @relation(fields: [actorId], references: [id])
  action     AuditAction
  entityType String // Patient, Encounter, Prescription...
  entityId   String?
  patientId  String? // denormalized for per-patient access reports
  detail     String?
  ip         String?
  sessionId  String?
  createdAt  DateTime    @default(now())

  @@index([practiceId, patientId, createdAt])
  @@index([practiceId, actorId, createdAt])
}
